<?php

/**
 * @file
 * Install functions for the Zambia agro-ecological zones module.
 */

declare(strict_types=1);

use Drupal\taxonomy\Entity\Term;
use Drupal\taxonomy\Entity\Vocabulary;

/**
 * Implements hook_install().
 *
 * Creates default terms for Zambia's three agro-ecological regions in the
 * agroecological_zone vocabulary (provided by this module's config/install).
 * Terms are only created if they do not already exist, so reinstalling
 * will not create duplicates.
 */
function farm_zambia_zones_install(): void {

  // Bail out if the vocabulary is not available.
  if (!Vocabulary::load('agroecological_zone')) {
    return;
  }

  // Zone name => description (rainfall range, geography, suitable
  // enterprises).
  $zones = [
    'Region I' => 'Low-rainfall zone: less than 800 mm of rain per year. Covers the southern valleys (Zambezi and Luangwa valleys) and parts of Southern and Western Provinces. Best suited to drought-tolerant enterprises: sorghum, pearl millet, cotton, groundnuts, livestock and game ranching. Rain-fed maize is risky here.',
    'Region II' => 'Medium-rainfall zone: 800 to 1000 mm of rain per year. Covers the central plateau, including Central, Lusaka and Eastern Provinces and the Southern plateau. This is Zambia\'s main agricultural belt: maize, soybeans, sunflower, groundnuts, tobacco and irrigated wheat, alongside mixed crop-livestock systems.',
    'Region III' => 'High-rainfall zone: more than 1000 mm of rain per year. Covers the northern high-rainfall areas, including Northern, Luapula, North-Western and Copperbelt Provinces. Suited to cassava, finger millet, beans, rice in dambos, and coffee. Soils tend to be acidic and leached, so liming is often needed.',
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach ($zones as $name => $description) {

    // Skip terms that already exist in the agroecological_zone vocabulary.
    $existing = $storage->loadByProperties(['name' => $name, 'vid' => 'agroecological_zone']);
    if (!empty($existing)) {
      continue;
    }

    $term = Term::create([
      'name' => $name,
      'vid' => 'agroecological_zone',
      'description' => $description,
    ]);
    $term->save();
  }
}
